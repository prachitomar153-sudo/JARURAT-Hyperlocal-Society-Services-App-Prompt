                <div key={lbl} style={{ background: "#fff", borderRadius: 14, padding: "12px 8px", textAlign: "center", border: "1.5px solid #f0f0f8" }}>
                  <div style={{ fontSize: 20 }}>{ico}</div>
                  <div style={{ fontWeight: 700, fontSize: 14, color: "#1a1a2e", marginTop: 4 }}>{val}</div>
                  <div style={{ fontSize: 11, color: "#aaa" }}>{lbl}</div>
                </div>
              ))}
            </div>
            <div style={{ background: "#fff", borderRadius: 16, padding: 16, marginBottom: 14, border: "1.5px solid #f0f0f8" }}>
              <div style={{ fontWeight: 700, marginBottom: 8, fontSize: 14 }}>Skills</div>
              <div style={{ display: "flex", flexWrap: "wrap", gap: 8 }}>
                {selectedProvider.skills.map(sk => (
                  <span key={sk} style={{ background: "#eef2ff", color: "#1a56db", fontSize: 12, borderRadius: 8, padding: "4px 10px", fontWeight: 600 }}>{sk}</span>
                ))}
              </div>
            </div>
            <div style={{ background: "#e8f8f0", borderRadius: 14, padding: "10px 16px", marginBottom: 20, display: "flex", alignItems: "center", gap: 8 }}>
              <span style={{ fontSize: 16 }}>⏰</span>
              <span style={{ color: "#10b981", fontWeight: 600, fontSize: 13 }}>{selectedProvider.avail}</span>
            </div>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
              <button onClick={() => nav("chat")} style={{ background: "#25D366", color: "#fff", border: "none", borderRadius: 14, padding: "14px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>💬 Chat</button>
              <button onClick={() => nav("booking")} style={{ background: "#1a56db", color: "#fff", border: "none", borderRadius: 14, padding: "14px 0", fontWeight: 700, fontSize: 14, cursor: "pointer" }}>Book Now</button>
            </div>
          </div>
        </div>
      )}

      {/* — BOOKING — */}
      {screen === "booking" && (
        <div style={{ padding: "20px 16px", paddingBottom: 90 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 24 }}>
            <button onClick={() => nav("home")} style={{ background: "#f0f0f8", border: "none", borderRadius: 10, padding: "8px 14px", cursor: "pointer", fontSize: 14 }}>←</button>
            <span style={{ fontWeight: 700, fontSize: 18, color: "#1a1a2e" }}>Book Service</span>
          </div>

          {/* Progress */}
          <div style={{ display: "flex", alignItems: "center", marginBottom: 28, gap: 0 }}>
            {["Select Date", "Add Address", "Confirm"].map((step, i) => (
              <div key={i} style={{ display: "flex", alignItems: "center", flex: 1 }}>
                <div style={{ display: "flex", flexDirection: "column", alignItems: "center", flex: 1 }}>
                  <div style={{ width: 28, height: 28, borderRadius: "50%", background: bookingStep > i ? "#1a56db" : bookingStep === i + 1 ? "#1a56db" : "#e0e0ef", display: "flex", alignItems: "center", justifyContent: "center", color: bookingStep >= i + 1 ? "#fff" : "#aaa", fontWeight: 700, fontSize: 13 }}>{i + 1}</div>
                  <div style={{ fontSize: 10, color: bookingStep >= i + 1 ? "#1a56db" : "#aaa", marginTop: 4, textAlign: "center" }}>{step}</div>
                </div>
                {i < 2 && <div style={{ height: 2, flex: 0.5, background: bookingStep > i + 1 ? "#1a56db" : "#e0e0ef", marginBottom: 16 }} />}
              </div>
            ))}
          </div>

          {bookingStep === 1 && (
            <div>
              <div style={{ fontWeight: 600, color: "#444", marginBottom: 10 }}>Select Date</div>
              <input type="date" value={bookingDate} onChange={e => setBookingDate(e.target.value)} style={{ width: "100%", padding: "12px 14px", borderRadius: 12, border: "1.5px solid #e0e0ef", fontSize: 15, outline: "none", boxSizing: "border-box", marginBottom: 20 }} />
              <div style={{ fontWeight: 600, color: "#444", marginBottom: 10 }}>Select Time</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 10 }}>
                {["9:00 AM", "11:00 AM", "1:00 PM", "3:00 PM", "5:00 PM", "7:00 PM"].map(t => (
                  <button key={t} onClick={() => setBookingTime(t)} style={{ background: bookingTime === t ? "#1a56db" : "#f4f4fc", color: bookingTime === t ? "#fff" : "#555", border: "none", borderRadius: 12, padding: "10px 0", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>{t}</button>
                ))}
              </div>
            </div>
          )}

          {bookingStep === 2 && (
            <div>
              <div style={{ fontWeight: 600, color: "#444", marginBottom: 10 }}>Your Address</div>
              <textarea placeholder="Flat No., Block, Society Name..." rows={3} style={{ width: "100%", padding: "12px 14px", borderRadius: 12, border: "1.5px solid #e0e0ef", fontSize: 14, outline: "none", resize: "none", boxSizing: "border-box", marginBottom: 16, fontFamily: "inherit" }} />
              <div style={{ fontWeight: 600, color: "#444", marginBottom: 10 }}>Additional Notes</div>
              <textarea value={bookingNote} onChange={e => setBookingNote(e.target.value)} placeholder="Any specific instructions for the provider..." rows={3} style={{ width: "100%", padding: "12px 14px", borderRadius: 12, border: "1.5px solid #e0e0ef", fontSize: 14, outline: "none", resize: "none", boxSizing: "border-box", fontFamily: "inherit" }} />
            </div>
          )}

          {bookingStep === 3 && (
            <div>
              <div style={{ background: "#fff", borderRadius: 18, border: "1.5px solid #e8e8f8", padding: 20, marginBottom: 16 }}>
                <div style={{ fontWeight: 700, fontSize: 16, marginBottom: 14, color: "#1a1a2e" }}>Booking Summary</div>
                {[["Service", selectedService?.name || "House Cleaning"], ["Provider", selectedProvider?.name || "Ramesh Kumar"], ["Date", bookingDate || "Tomorrow"], ["Time", bookingTime || "11:00 AM"], ["Rate", selectedProvider?.price || "₹199/hr"]].map(([k, v]) => (
                  <div key={k} style={{ display: "flex", justifyContent: "space-between", marginBottom: 10, fontSize: 14 }}>
                    <span style={{ color: "#888" }}>{k}</span>
                    <span style={{ fontWeight: 600, color: "#1a1a2e" }}>{v}</span>
                  </div>
                ))}
                <div style={{ borderTop: "1px solid #f0f0f8", marginTop: 10, paddingTop: 12, display: "flex", justifyContent: "space-between" }}>
                  <span style={{ fontWeight: 700, color: "#1a1a2e" }}>Est. Total</span>
                  <span style={{ fontWeight: 800, color: "#1a56db", fontSize: 18 }}>₹399</span>
                </div>
              </div>
              <div style={{ fontWeight: 600, color: "#444", marginBottom: 10 }}>Payment Method</div>
              <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
                {[["💳", "UPI"], ["🟢", "GPay"], ["🔵", "PhonePe"], ["💰", "Wallet"]].map(([ico, label]) => (
                  <div key={label} style={{ background: label === "UPI" ? "#eef2ff" : "#fff", border: label === "UPI" ? "2px solid #1a56db" : "1.5px solid #e8e8f8", borderRadius: 12, padding: "12px 14px", display: "flex", alignItems: "center", gap: 10, cursor: "pointer" }}>
                    <span style={{ fontSize: 20 }}>{ico}</span>
                    <span style={{ fontWeight: 600, fontSize: 13, color: label === "UPI" ? "#1a56db" : "#555" }}>{label}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <button onClick={confirmBooking} style={{ width: "100%", background: "#1a56db", color: "#fff", border: "none", borderRadius: 14, padding: "16px 0", fontWeight: 700, fontSize: 16, cursor: "pointer", marginTop: 24 }}>
            {bookingStep < 3 ? "Continue →" : "Confirm & Pay ₹399"}
          </button>
        </div>
      )}

      {/* — CHAT — */}
      {screen === "chat" && (
        <div style={{ display: "flex", flexDirection: "column", height: "100vh" }}>
          <div style={{ background: "#fff", padding: "16px 16px 14px", borderBottom: "1px solid #f0f0f8", display: "flex", alignItems: "center", gap: 14 }}>
            <button onClick={() => nav("home")} style={{ background: "#f4f4fc", border: "none", borderRadius: 10, padding: "7px 12px", cursor: "pointer", fontSize: 14 }}>←</button>
            <div style={{ width: 40, height: 40, borderRadius: "50%", background: "#eef2ff", display: "flex", alignItems: "center", justifyContent: "center", fontWeight: 700, color: "#1a56db", fontSize: 14 }}>RK</div>
            <div>
              <div style={{ fontWeight: 700, fontSize: 15, color: "#1a1a2e" }}>Ramesh Kumar</div>
              <div style={{ fontSize: 11, color: "#10b981" }}>● Online</div>
            </div>
          </div>
          <div style={{ flex: 1, padding: 16, overflowY: "auto", display: "flex", flexDirection: "column", gap: 12, background: "#f8f9fb" }}>
            {messages.map((m, i) => (
              <div key={i} style={{ display: "flex", justifyContent: m.from === "user" ? "flex-end" : "flex-start" }}>
                <div style={{ background: m.from === "user" ? "#1a56db" : "#fff", color: m.from === "user" ? "#fff" : "#1a1a2e", borderRadius: m.from === "user" ? "18px 18px 4px 18px" : "18px 18px 18px 4px", padding: "10px 14px", maxWidth: "75%", fontSize: 14, lineHeight: 1.5, border: m.from !== "user" ? "1px solid #f0f0f8" : "none" }}>{m.text}</div>
              </div>
            ))}
          </div>
          <div style={{ background: "#fff", padding: "12px 16px", borderTop: "1px solid #f0f0f8", display: "flex", gap: 10 }}>
            <input value={chatInput} onChange={e => setChatInput(e.target.value)} onKeyDown={e => e.key === "Enter" && sendChat()} placeholder="Type a message..." style={{ flex: 1, background: "#f4f4fc", border: "none", borderRadius: 12, padding: "10px 14px", fontSize: 14, outline: "none" }} />
            <button onClick={sendChat} style={{ background: "#1a56db", color: "#fff", border: "none", borderRadius: 12, width: 44, height: 44, fontSize: 18, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}>➤</button>
          </div>
        </div>
      )}

      {/* — COMMUNITY — */}
      {screen === "community" && (
        <div style={{ padding: "20px 16px", paddingBottom: 80 }}>
          <div style={{ fontWeight: 800, fontSize: 20, color: "#1a1a2e", marginBottom: 20 }}>Community 🏘️</div>
          <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
            {announcements.map(a => (
              <div key={a.id} style={{ background: "#fff", borderRadius: 16, padding: "14px 16px", border: "1.5px solid #f0f0f8", display: "flex", gap: 14, alignItems: "flex-start" }}>
                <div style={{ width: 40, height: 40, borderRadius: 12, background: a.type === "alert" ? "#fff0f0" : a.type === "event" ? "#f0f7ff" : "#fff8e6", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20, flexShrink: 0 }}>{a.icon}</div>
                <div style={{ flex: 1 }}>
                  <div style={{ fontWeight: 600, fontSize: 14, color: "#1a1a2e", lineHeight: 1.4 }}>{a.title}</div>
                  <div style={{ fontSize: 11, color: "#aaa", marginTop: 6 }}>{a.time}</div>
                </div>
              </div>
            ))}
          </div>
          <div style={{ background: "#fff", borderRadius: 16, padding: 16, marginTop: 20, border: "1.5px solid #f0f0f8" }}>
            <div style={{ fontWeight: 700, fontSize: 15, marginBottom: 14 }}>📊 Community Poll</div>
            <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 14, color: "#444" }}>Should we add a new gym in the society?</div>
            {[["Yes, definitely!", 72], ["No, not needed", 18], ["Maybe later", 10]].map(([opt, pct]) => (
              <div key={opt} style={{ marginBottom: 10 }}>
                <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, marginBottom: 4 }}>
                  <span style={{ color: "#444" }}>{opt}</span>
                  <span style={{ color: "#1a56db", fontWeight: 700 }}>{pct}%</span>
                </div>
                <div style={{ background: "#f0f0f8", borderRadius: 8, height: 8, overflow: "hidden" }}>
                  <div style={{ background: "#1a56db", height: "100%", width: `${pct}%`, borderRadius: 8 }} />
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* — MARKETPLACE — */}
      {screen === "marketplace" && (
        <div style={{ padding: "20px 16px", paddingBottom: 80 }}>
          <div style={{ fontWeight: 800, fontSize: 20, color: "#1a1a2e", marginBottom: 20 }}>Marketplace 🛍️</div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
            {[
              { emoji: "🛋️", title: "Sofa Set (3+2)", price: "₹8,000", seller: "Flat 301", tag: "Furniture" },
              { emoji: "📺", title: "LED TV 43\"", price: "₹12,500", seller: "Flat 204", tag: "Electronics" },
              { emoji: "🚲", title: "Cycle – Hero", price: "₹2,500", seller: "Flat 108", tag: "Sports" },
              { emoji: "🧊", title: "Refrigerator 220L", price: "₹7,000", seller: "Flat 412", tag: "Appliance" },
              { emoji: "📚", title: "UPSC Books Set", price: "₹1,200", seller: "Flat 502", tag: "Books" },
              { emoji: "🪑", title: "Study Table + Chair", price: "₹3,500", seller: "Flat 203", tag: "Furniture" },
            ].map((item, i) => (
              <div key={i} style={{ background: "#fff", borderRadius: 16, overflow: "hidden", border: "1.5px solid #f0f0f8", cursor: "pointer" }}>
                <div style={{ background: "#f4f4fc", height: 90, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 44 }}>{item.emoji}</div>
                <div style={{ padding: "10px 12px" }}>
                  <div style={{ fontWeight: 700, fontSize: 13, color: "#1a1a2e", marginBottom: 2 }}>{item.title}</div>
                  <div style={{ fontSize: 11, color: "#aaa", marginBottom: 6 }}>By {item.seller}</div>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                    <span style={{ fontWeight: 800, color: "#1a56db", fontSize: 15 }}>{item.price}</span>
                    <span style={{ fontSize: 10, background: "#eef2ff", color: "#1a56db", padding: "2px 7px", borderRadius: 6, fontWeight: 600 }}>{item.tag}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* — BOTTOM NAV — */}
      {!["landing"].includes(screen) && (
        <div style={{ position: "fixed", bottom: 0, left: "50%", transform: "translateX(-50%)", width: "100%", maxWidth: 400, background: "rgba(255,255,255,0.97)", backdropFilter: "blur(20px)", borderTop: "1px solid #f0f0f8", display: "flex", padding: "8px 0 12px", zIndex: 50 }}>
          {[
            { id: "home", icon: "🏠", label: "Home" },
            { id: "marketplace", icon: "🛍️", label: "Market" },
            { id: "booking", icon: "📅", label: "Book" },
            { id: "community", icon: "🏘️", label: "Society" },
            { id: "chat", icon: "💬", label: "Chat" },
          ].map(tab => (
            <button key={tab.id} onClick={() => nav(tab.id)} style={{ flex: 1, background: "none", border: "none", cursor: "pointer", display: "flex", flexDirection: "column", alignItems: "center", gap: 3, padding: "4px 0" }}>
              <span style={{ fontSize: 20, filter: screen === tab.id ? "none" : "grayscale(1) opacity(0.5)" }}>{tab.icon}</span>
              <span style={{ fontSize: 10, color: screen === tab.id ? "#1a56db" : "#aaa", fontWeight: screen === tab.id ? 700 : 400 }}>{tab.label}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  );
} 
